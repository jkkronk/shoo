# fastlane configuration for Shoo.
# Local mirror of CI plus the App Store release path. The release lanes need Xcode 26
# signed in to the developer account (team 8HW5ABG4L2) or an App Store Connect API key
# in ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH. See docs/APP_STORE_READINESS.md.

default_platform(:mac)

platform :mac do
  desc "Run unit/integration tests with coverage"
  lane :tests do
    sh("cd .. && xcodegen generate")
    run_tests(
      project: "Shoo.xcodeproj",
      scheme: "Shoo",
      destination: "platform=macOS",
      code_coverage: true,
      xcargs: 'CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY=""'
    )
  end

  desc "Build an unsigned archive (CI smoke check; no signing)"
  lane :build_unsigned do
    sh("cd .. && xcodegen generate")
    build_mac_app(
      project: "Shoo.xcodeproj",
      scheme: "Shoo",
      configuration: "Release",
      skip_codesigning: true,
      skip_package_pkg: true,
      archive_path: "build/Shoo.xcarchive",
      output_directory: "build"
    )
  end

  desc "Bump the build number in project.yml (source of truth) and regenerate"
  lane :bump do
    spec = File.expand_path("../project.yml", __dir__)
    text = File.read(spec)
    current = text[/CURRENT_PROJECT_VERSION:\s*"?(\d+)"?/, 1].to_i
    text.sub!(/CURRENT_PROJECT_VERSION:\s*"?\d+"?/, "CURRENT_PROJECT_VERSION: \"#{current + 1}\"")
    File.write(spec, text)
    sh("cd .. && xcodegen generate")
    UI.success("CURRENT_PROJECT_VERSION #{current} → #{current + 1}")
  end

  desc "Archive + export an App Store .pkg into build/export (no upload)"
  lane :archive do
    sh("cd .. && bash scripts/release.sh")
  end

  desc "Archive + upload to App Store Connect / TestFlight"
  lane :release do
    sh("cd .. && bash scripts/release.sh --upload")
  end

  desc "Capture App Store screenshots at 2560×1600 (interactive, Retina display)"
  lane :screenshots do
    sh("cd .. && bash scripts/screenshots.sh")
  end
end
